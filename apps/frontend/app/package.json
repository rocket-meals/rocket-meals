{
  "name": "rocket-meals-dev",
  "main": "expo-router/entry",
  "homepage": "/rocket-meals",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "lint": "expo lint",
    "predeploy": "expo export -p web",
    "deploy": "yarn run copy-assets && node ./scripts/deploy-gh-pages.js",
    "copy-assets": "cpx \"node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/**/*\" \"dist/assets/node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts\"",
    "deploy:gh:pages": "yarn run predeploy && yarn run deploy",
    "eas-build-post-install": "node ./scripts/eas-build-post-install.js",
    "deploy:local": "yarn run export:web:dev && mkdir -p ./serveDist/rocket-meals && cp -r ./dist/* ./serveDist/rocket-meals/ && npx serve serveDist",
    "export:web": "expo export --platform web",
    "export:web:dev": "expo export --platform web",
    "maestro:generate": "ts-node --project ../maestro-tests/tsconfig.json ../maestro-tests/generate.ts",
    "maestro": "bash ../run-maestro-web-test.sh",
    "maestro:runOnly": "bash ../run-maestro-web-test.sh --skip-generate"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|standard-navigation|@sentry/react-native|native-base|react-redux|@dicebear))",
      "/node_modules/react-native-reanimated/plugin/"
    ]
  },
