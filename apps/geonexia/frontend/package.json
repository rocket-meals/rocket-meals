{
  "name": "geonexia",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "test": "jest",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "export:web": "expo export --platform web"
  },
  "jest": {
    "preset": "jest-expo",
    "resolver": "<rootDir>/jest.resolver.js",
    "moduleNameMapper": {
      "expo-modules-core/src/web/index\\.web": "<rootDir>/emptyModule.js",
      "expo-modules-core/src/uuid/uuid\\.web": "<rootDir>/emptyModule.js"
    },
    "setupFiles": [
      "react-native-gesture-handler/jestSetup",
      "./jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|standard-navigation|@sentry/react-native|native-base|react-redux|@dicebear))",
      "/node_modules/react-native-reanimated/plugin/"
    ]
  },
  "dependencies": {
    "@babel/runtime": "^7.26.0",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.9",
    "@mapbox/vector-tile": "1.3.1",
    "@react-navigation/drawer": "^7.0.0",
    "@reduxjs/toolkit": "^2.5.1",
    "expo": "58.0.26",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
