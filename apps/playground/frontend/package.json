{
  "name": "playground",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "generate:icon": "node scripts/generate-app-icon.js",
    "generate:eas": "ts-node --project ../scripts/tsconfig.json ../scripts/generate-eas-config.ts",
    "appstore:create-app": "node ../../../scripts/appstore-create-app.js apps/playground/frontend",
    "download-prebuilt": "download-prebuilt",
    "eas-build-post-install": "yarn download-prebuilt"
  },
  "dependencies": {
    "@babel/runtime": "^7.26.0",
    "@borndotcom/react-native-godot": "1.0.1",
    "@expo/vector-icons": "^15.0.3",
    "expo": "54.0.37",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.20",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "react-native-worklets-core": "1.6.2",
    "repo-depkit-common": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/node": "^24.9.1",
    "@types/react": "~19.1.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
