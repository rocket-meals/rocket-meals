{
  "name": "score-tracker",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "export:web": "expo export --platform web",
    "generate:eas": "ts-node --project ../scripts/tsconfig.json ../scripts/generate-eas-config.ts",
    "maestro:generate": "ts-node --project ../maestro-tests/tsconfig.json ../maestro-tests/generate.ts",
    "maestro": "bash ../run-maestro-web-test.sh",
    "maestro:runOnly": "bash ../run-maestro-web-test.sh --skip-generate",
    "test": "jest"
  },
  "jest": {
    "preset": "jest-expo",
    "resolver": "<rootDir>/jest.resolver.js",
    "moduleNameMapper": {
      "expo-modules-core/src/web/index\\.web": "<rootDir>/emptyModule.js",
      "expo-modules-core/src/uuid/uuid\\.web": "<rootDir>/emptyModule.js",
      "^immer$": "<rootDir>/../../../node_modules/immer/dist/cjs/index.js"
    }
  },
  "dependencies": {
    "@babel/runtime": "^7.26.0",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.9",
    "@react-navigation/drawer": "^7.0.0",
    "@reduxjs/toolkit": "^2.5.1",
    "expo": "58.0.26",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.22",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-redux": "^9.2.0",
    "repo-depkit-common": "workspace:*",
    "repo-depkit-common-ui": "workspace:*",
    "repo-depkit-maestro-framework": "workspace:*",
    "setimmediate": "^1.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@react-native/jest-preset": "0.88.1",
    "@types/node": "^24.9.1",
    "@types/react": "~19.3.0",
    "@types/react-native": "^0.73.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "private": true
}
