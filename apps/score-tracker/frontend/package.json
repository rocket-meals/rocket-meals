{
  "name": "score-tracker",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "export:web": "expo export --platform web",
    "generate:eas": "ts-node --project ../scripts/tsconfig.json ../scripts/generate-eas-config.ts",
    "maestro:generate": "ts-node --project ../maestro-tests/tsconfig.json ../maestro-tests/generate.ts",
    "maestro": "bash ../run-maestro-web-test.sh",
    "maestro:runOnly": "bash ../run-maestro-web-test.sh --skip-generate",
    "test": "jest"
  },
  "jest": {
    "preset": "jest-expo",
    "resolver": "<rootDir>/jest.resolver.js",
    "moduleNameMapper": {
      "expo-modules-core/src/web/index\\.web": "<rootDir>/emptyModule.js",
      "expo-modules-core/src/uuid/uuid\\.web": "<rootDir>/emptyModule.js",
      "^immer$": "<rootDir>/../../../node_modules/immer/dist/cjs/index.js"
    }
  },
  "dependencies": {
    "@babel/runtime": "^7.26.0",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.9",
    "@reduxjs/toolkit": "^2.5.1",
    "expo": "57.0.11",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.9",
    "expo-dev-client": "~57.0.10",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-image-manipulator": "~57.0.8",
    "expo-image-picker": "~57.0.8",
    "expo-linking": "~57.0.5",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.11",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.12",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-redux": "^9.2.0",
    "repo-depkit-common": "workspace:*",
    "repo-depkit-common-ui": "workspace:*",
    "repo-depkit-maestro-framework": "workspace:*",
    "setimmediate": "^1.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native/jest-preset": "0.86.2",
    "@types/node": "^24.9.1",
    "@types/react": "~19.2.0",
    "@types/react-native": "^0.73.0",
    "jest": "^29.2.1",
    "jest-expo": "~57.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "private": true
}
