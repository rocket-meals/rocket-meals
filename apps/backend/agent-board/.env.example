# Kopieren nach .env (wird nicht eingecheckt) und anpassen. Schlüssel nie in Prompts/Chats/Repos schreiben.

# --- Schlüssel (mindestens einer, sobald der Server nicht nur an localhost hängt, z. B. im Container) ---
# Variante A (empfohlen): benannte Schlüssel mit Rolle, angelegt per
#   npm run key -- create --name nils-web --role admin
#   npm run key -- create --name claude-mac --role agent --providers claude
#   npm run key -- create --name uhrzeit --role program
# → gespeichert nur als SHA-256 in data/keys.json (Container: docker compose exec agent-board node --import tsx src/cli/key.ts …)
#
# Variante B (Docker ohne CLI): AB_KEYS als JSON; statt "key" besser "hash" (sha256 hex des Schlüssels):
# AB_KEYS=[{"name":"claude-mac","role":"agent","providers":["claude"],"hash":"<sha256>"},{"name":"uhrzeit","role":"program","hash":"<sha256>"}]
#
# Abwärtskompatibel: einzelner admin-Schlüssel
AB_API_KEY=bitte-aendern-openssl-rand-hex-16

# Schlüssel, den Claude (MCP stdio, Watcher) benutzt – Rolle agent, z. B. --providers claude.
# Besser NICHT hier, sondern in der Shell-Umgebung von Claude Code setzen (export AB_AGENT_KEY=…);
# .mcp.json liest ${AB_AGENT_KEY} aus der Umgebung.
# AB_AGENT_KEY=

# Dein Name (Erwähnungen @nils, Ansicht „Für mich“) und Autorname des Agenten
AB_USER=nils
AB_AGENT_NAME=claude

# Basis-URL für Download-Links im HTTP-MCP (z. B. wenn der Server im WLAN erreichbar ist)
# AB_PUBLIC_URL=http://192.168.1.20:4317

# AB_MAX_FILE_MB=25
# AB_COMPLETION_TIMEOUT=600
# Sperre eines übernommenen Issues (claim) läuft nach so vielen Minuten ohne Aktivität ab
# AB_CLAIM_TTL_MIN=30
# Fehlversuche (falscher Schlüssel) pro IP und Minute, danach HTTP 429
# AB_AUTH_FAIL_LIMIT=10

# WLAN-Zugriff (z. B. iPhone): 0.0.0.0, sonst nur dieser Rechner
# AB_BIND=0.0.0.0
