  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native/jest-preset": "0.86.2",
    "@types/node": "^24.9.1",
    "@types/react": "~19.2.0",
    "jest": "^29.2.1",
    "jest-expo": "~57.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
