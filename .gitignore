apps/geonexia/frontend/assets/icons_hash.json
# New location – commit all generated assets (like score-tracker) except the hash file
apps/geonexia/frontend/assets/generated/icons_hash.json

apps/screenshotGenerator/dist/
apps/screenshotGenerator/.yarn/
apps/screenshotGenerator/.yarnrc.yml
