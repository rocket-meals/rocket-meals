{
  "private": true,
  "name": "monorepo",
  "version": "1.0.0",
  "scripts": {
    "frontend": "yarn app-frontend-start",
    "geonexia": "yarn workspace geonexia start",
    "app-frontend-start": "yarn && yarn workspace rocket-meals-dev start",
    "app-frontend-gh-pages-deploy": "yarn && yarn workspace rocket-meals-dev deploy:gh:pages",
    "sync:pull-from-test-system": "yarn && yarn workspace backend-sync sync:pull-from-test-system",
    "test": "yarn && yarn app-backend-test",
    "build": "yarn && yarn app-backend-build",
    "app-backend-test": "yarn workspace directus-extension-rocket-meals-bundle test",
    "app-backend-build": "yarn workspace directus-extension-rocket-meals-bundle build",
    "app-backend-build-without-test": "yarn workspace directus-extension-rocket-meals-bundle buildWithoutTest",
    "clean": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "clean-install": "yarn clean && yarn",
    "format": "prettier . --write",
    "lint": "eslint . --ext .js,.ts,.tsx --fix",
    "analyze-data-clumps": "yarn workspace rocket-meals-scripts analyze:data-clumps",
    "store-metadata:pull:rocket-meals": "yarn workspace rocket-meals-scripts store-metadata pull --module apps/frontend/app/store-metadata.ts",
    "store-metadata:push:rocket-meals": "yarn workspace rocket-meals-scripts store-metadata push --module apps/frontend/app/store-metadata.ts",
    "store-metadata:pull:geonexia": "yarn workspace rocket-meals-scripts store-metadata pull --module apps/geonexia/frontend/store-metadata.ts",
    "store-metadata:push:geonexia": "yarn workspace rocket-meals-scripts store-metadata push --module apps/geonexia/frontend/store-metadata.ts",
    "store-metadata:pull:score-tracker": "yarn workspace rocket-meals-scripts store-metadata pull --module apps/score-tracker/frontend/store-metadata.ts",
    "store-metadata:push:score-tracker": "yarn workspace rocket-meals-scripts store-metadata push --module apps/score-tracker/frontend/store-metadata.ts",
    "store-metadata:pull:tag-und-jahr": "yarn workspace rocket-meals-scripts store-metadata pull --module apps/tag-und-jahr/frontend/store-metadata.ts",
    "store-metadata:push:tag-und-jahr": "yarn workspace rocket-meals-scripts store-metadata push --module apps/tag-und-jahr/frontend/store-metadata.ts"
  },
  "workspaces": [
    "apps/frontend/app",
    "apps/geonexia/frontend",
    "apps/score-tracker/frontend",
    "apps/tag-und-jahr/frontend",
    "apps/backend/Backend/directusExtensions/directus-extension-rocket-meals-bundle",
    "apps/scripts",
    "apps/*",
    "packages/*"
  ],
  "packageManager": "yarn@4.9.4",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "eslint": "^8.57.0",
    "node-gyp": "^10.2.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "resolutions": {
    "react-native-leaflet-view@npm:^1.1.2": "patch:react-native-leaflet-view@npm%3A1.1.2#~/.yarn/patches/react-native-leaflet-view-npm-1.1.2-jcenter-fix.patch"
  }
}
